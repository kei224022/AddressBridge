{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "CLAUDE.md",
      "SCREEN_SPEC.md",
      "API_SPEC.md",
      "TEST_SPEC.md",
      "TODO.md",
      "FirebaseMemo.md",
      "eslint.config.js",
      "package.json",
      "package-lock.json",
      "phase4_test.mjs",
      "pw_test.mjs",
      "staging_test.mjs",
      "gen_ogp.mjs",
      "task.md",
      "**/*.log",
      "tests/**",
      "js/config.example.js",
      "ScreenShot/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
